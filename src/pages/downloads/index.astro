---
import { getCollection } from "astro:content";
import Layout from "../../layouts/Layout.astro";
import DownloadTable from "../../components/DownloadTable.astro";
import Breadcrumbs from "../../components/Breadcrumbs.astro";
import { withBase, slugifyToken } from "../../lib/url";
import { isPublished, byDateDesc } from "../../lib/content";

const downloads = (await getCollection("downloads", isPublished)).sort(byDateDesc);

const categories = [...new Set(downloads.map((d) => d.data.category))].sort();
---

<Layout title="Downloads" description="Software and file archive.">
  <Breadcrumbs items={[{ label: "Downloads" }]} />
  <h1>Downloads</h1>
  <p class="text-muted">
    A small archive of software, tools and files. Click a name for full details - version, file size,
    checksums and notes - before you download it.
  </p>

  {
    categories.length > 1 && (
      <p class="no-margin" style="margin-bottom:1em;">
        <span class="text-mono text-muted" style="font-size:0.75rem;">jump to:</span>{" "}
        {categories.map((category, i) => (
          <>
            {i > 0 && " · "}
            <a href={withBase(`/downloads/category/${slugifyToken(category)}/`)}>{category}</a>
          </>
        ))}
      </p>
    )
  }

  {
    downloads.length > 0 ? (
      <DownloadTable downloads={downloads} showCategory />
    ) : (
      <p class="text-muted">No downloads yet - add one in src/content/downloads/.</p>
    )
  }
</Layout>

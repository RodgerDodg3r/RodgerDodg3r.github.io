---
import { getCollection } from "astro:content";
import Layout from "../../../layouts/Layout.astro";
import PostPreview from "../../../components/PostPreview.astro";
import Breadcrumbs from "../../../components/Breadcrumbs.astro";
import { isPublished, byDateDesc } from "../../../lib/content";
import { slugifyToken } from "../../../lib/url";

export async function getStaticPaths() {
  const posts = await getCollection("posts", isPublished);
  const map = new Map<string, { label: string; slug: string }>();
  for (const post of posts) {
    for (const tag of post.data.tags) {
      const slug = slugifyToken(tag);
      if (!map.has(slug)) map.set(slug, { label: tag, slug });
    }
  }
  return [...map.values()].map(({ label, slug }) => ({
    params: { tag: slug },
    props: { tagLabel: label },
  }));
}

const { tagLabel } = Astro.props;
const allPosts = await getCollection("posts", isPublished);
const posts = allPosts.filter((p) => p.data.tags.map(slugifyToken).includes(Astro.params.tag!)).sort(byDateDesc);
---

<Layout title={`Posts tagged "${tagLabel}"`} description={`Posts tagged ${tagLabel}.`}>
  <Breadcrumbs items={[{ label: "News / Posts", href: "/posts/" }, { label: `tag: ${tagLabel}` }]} />
  <h1>Posts tagged &ldquo;{tagLabel}&rdquo;</h1>
  <div class="stack">
    {posts.map((post) => (
      <PostPreview post={post} />
    ))}
  </div>
  <p><a href="../../">&laquo; back to all posts</a></p>
</Layout>

---
import { getCollection } from "astro:content";
import Layout from "../../layouts/Layout.astro";
import PostPreview from "../../components/PostPreview.astro";
import Breadcrumbs from "../../components/Breadcrumbs.astro";
import { isPublished, byDateDesc } from "../../lib/content";

const posts = (await getCollection("posts", isPublished)).sort(byDateDesc);
---

<Layout title="News / Posts" description="Devlog and news posts.">
  <Breadcrumbs items={[{ label: "News / Posts" }]} />
  <h1>News / Posts</h1>
  <p class="text-muted">Devlog entries, announcements and whatever else feels worth writing down.</p>

  {
    posts.length > 0 ? (
      <div class="stack">
        {posts.map((post) => (
          <PostPreview post={post} />
        ))}
      </div>
    ) : (
      <p class="text-muted">No posts yet - add one in src/content/posts/.</p>
    )
  }
</Layout>

---
import { getCollection } from "astro:content";
import Layout from "../../layouts/Layout.astro";
import SoftwareCard from "../../components/SoftwareCard.astro";
import Breadcrumbs from "../../components/Breadcrumbs.astro";
import { isPublished, byDateDesc } from "../../lib/content";

const software = (await getCollection("software", isPublished)).sort(byDateDesc);
---

<Layout title="Software" description="Software, tools and other projects.">
  <Breadcrumbs items={[{ label: "Software" }]} />
  <h1>Software</h1>
  <p class="text-muted">
    Tools, apps, websites and experiments. Not everything here is finished - that's kind of the point of
    sharing work in progress.
  </p>

  {
    software.length > 0 ? (
      <div class="card-grid">
        {software.map((item) => (
          <SoftwareCard software={item} />
        ))}
      </div>
    ) : (
      <p class="text-muted">Nothing here yet - add an entry in src/content/software/.</p>
    )
  }
</Layout>

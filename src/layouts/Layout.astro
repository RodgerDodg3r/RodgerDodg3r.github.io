---
import "../styles/global.css";
import "../styles/layout.css";
import SEO from "../components/SEO.astro";
import Header from "../components/Header.astro";
import Sidebar from "../components/Sidebar.astro";
import Footer from "../components/Footer.astro";
import { withBase } from "../lib/url";

interface Props {
  title: string;
  description?: string;
  image?: string;
  noIndex?: boolean;
  /** Render main content full-bleed (no default panel padding). Rarely needed. */
  flushMain?: boolean;
}

const { title, description, image, noIndex, flushMain = false } = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <SEO title={title} description={description} image={image} noIndex={noIndex} />
    <link rel="icon" type="image/svg+xml" href={withBase("/favicon.svg")} />
  </head>
  <body>
    <a class="skip-link" href="#main-content">Skip to main content</a>
    <div class="site-frame">
      <div class="site-shell">
        <Header />
        <div class="site-body">
          <Sidebar />
          <main id="main-content" class:list={["site-main", flushMain && "site-main--flush"]}>
            <slot />
          </main>
        </div>
        <Footer />
      </div>
    </div>
  </body>
</html>

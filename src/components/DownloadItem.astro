---
import type { DownloadEntry } from "../lib/content";
import { entrySlug } from "../lib/content";
import { withBase, formatDate } from "../lib/url";

interface Props {
  download: DownloadEntry;
}

const { download } = Astro.props;
const href = withBase(`/downloads/${entrySlug(download)}/`);
---

<div class="row-list__item">
  <div class="row-list__icon" aria-hidden="true">
    {
      download.data.icon ? (
        <img src={withBase(download.data.icon)} alt="" loading="lazy" />
      ) : (
        <span>{download.data.category.slice(0, 3).toUpperCase()}</span>
      )
    }
  </div>
  <div class="row-list__body">
    <h3 class="row-list__title">
      <a href={href}>{download.data.title}</a>
    </h3>
    <p class="card__summary" style="margin-bottom:4px;">{download.data.description}</p>
    <div class="meta-line">
      {download.data.category}
      {download.data.version && ` · v${download.data.version}`}
      {download.data.fileSize && ` · ${download.data.fileSize}`}
      {` · ${formatDate(download.data.date)}`}
      {download.data.platforms.length > 0 && ` · ${download.data.platforms.join("/")}`}
    </div>
  </div>
</div>

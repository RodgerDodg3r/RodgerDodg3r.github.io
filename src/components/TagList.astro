---
import { withBase, slugifyToken } from "../lib/url";

interface Props {
  tags: string[];
  /**
   * Base listing path each tag should link to, e.g. "/games/" - links to a
   * statically-generated tag archive page at "/games/tag/<slug>/". Omit to
   * render plain (non-linked) tag badges.
   */
  linkTo?: string;
  class?: string;
}

const { tags, linkTo, class: className } = Astro.props;
---

{
  tags && tags.length > 0 && (
    <ul class:list={["tag-list", className]} role="list">
      {tags.map((tag) => (
        <li>
          {linkTo ? (
            <a class="tag" href={withBase(`${linkTo}tag/${slugifyToken(tag)}/`)}>
              {tag}
            </a>
          ) : (
            <span class="tag">{tag}</span>
          )}
        </li>
      ))}
    </ul>
  )
}

---
import type { PostEntry } from "../lib/content";
import { entrySlug } from "../lib/content";
import { withBase, formatDate, isoDate } from "../lib/url";
import TagList from "./TagList.astro";

interface Props {
  post: PostEntry;
  compact?: boolean;
}

const { post, compact = false } = Astro.props;
const href = withBase(`/posts/${entrySlug(post)}/`);
---

<article class="post-preview">
  <h3 class="post-preview__title">
    <a href={href}>{post.data.title}</a>
  </h3>
  <div class="meta-line">
    <time datetime={isoDate(post.data.date)}>{formatDate(post.data.date)}</time>
  </div>
  {!compact && <p class="card__summary">{post.data.summary}</p>}
  {!compact && post.data.tags.length > 0 && <TagList tags={post.data.tags} linkTo="/posts/" />}
</article>

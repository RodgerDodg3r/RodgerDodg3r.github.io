---
import type { ProjectEntry } from "../lib/content";
import { entrySlug } from "../lib/content";
import { withBase, formatDate } from "../lib/url";
import StatusBadge from "./StatusBadge.astro";

interface Props {
  project: ProjectEntry;
}

const { project } = Astro.props;
const href = withBase(`/projects/${entrySlug(project)}/`);
---

<article class="card">
  <a href={href} class="card__thumb" tabindex="-1" aria-hidden="true">
    {
      project.data.thumbnail ? (
        <img src={withBase(project.data.thumbnail)} alt="" loading="lazy" />
      ) : (
        <span class="card__thumb-placeholder">no image<br />available</span>
      )
    }
  </a>
  <div class="card__body">
    <h3 class="card__title">
      <a href={href}>{project.data.title}</a>
    </h3>
    <p class="card__summary">{project.data.summary}</p>
    <div class="meta-line">{formatDate(project.data.date)}</div>
    <div class="card__footer">
      <StatusBadge status={project.data.status} />
      {project.data.technologies.length > 0 && (
        <span class="marquee-note">{project.data.technologies.slice(0, 3).join(", ")}</span>
      )}
    </div>
  </div>
</article>
